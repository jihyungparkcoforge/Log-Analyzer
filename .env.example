# Copy this file to .env and replace the placeholders with your Azure settings.
# Never commit .env or real API keys.
OPENAI_API_KEY=your-api-key
ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# Use the deployment name configured on the resource above.
OPENAI_MODEL=gpt-6-astra
# Fraction of lines that may be unreadable (0.5 = 50%). Above this, the CLI
# warns with the observed percent and aborts unless you confirm in a terminal.
MALFORMED_THRESHOLD_PERCENT=0.5
